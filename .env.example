# CredentialIQ AI Environment Configuration Example
# Copy to .env or set environment variables before running

# Local DB Connection String (defaults to Data Source=credentialiq.db if omitted)
ConnectionStrings__DefaultConnection=Data Source=credentialiq.db

# LLM Configuration: Deterministic (default local) or Gemini
Llm__Provider=Deterministic

# Gemini API Integration (Only set if Llm__Provider=Gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
Gemini__Model=gemini-2.5-flash
Gemini__Endpoint=https://generativelanguage.googleapis.com/v1beta/models/
